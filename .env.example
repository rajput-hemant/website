# Sanity. Leave the project id empty to run on the bundled fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token: draft-mode preview.
SANITY_API_READ_TOKEN=
# Editor token: seed script and the /ask submission route.
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=
# Canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret used to sign the anonymous /ask identity cookie and salt IP hashes.
ASK_COOKIE_SECRET=
