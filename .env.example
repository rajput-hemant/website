# Copy to .env.local and restart `bun run dev` after changes.
# Every variable is optional: with none set, the site builds and renders the
# bundled fallback content in content/fallback/. See docs/guides/sanity.md.

# --- Sanity -------------------------------------------------------------------
# Project id from https://www.sanity.io/manage. Leave empty to run on the
# bundled fallback content (no network calls, /ask answers 503).
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset name. Keep it private: question documents hold private fields.
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token (API > Tokens). Server-only. Used for every published read
# (required with a private dataset) and for draft-mode preview.
SANITY_API_READ_TOKEN=
# Editor token (API > Tokens). Server-only. Used by `bun run seed`,
# `bun run doctor` and the /ask routes to write threads, replies and moderation.
SANITY_API_WRITE_TOKEN=
# Shared secret for the signed Sanity webhook that calls /api/revalidate.
# Any long random string, e.g. `openssl rand -hex 32`.
SANITY_REVALIDATE_SECRET=

# --- Site ---------------------------------------------------------------------
# Canonical site URL, no trailing slash. Used for metadata, the sitemap,
# markdown mirrors and llms.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Pins the deploy to one live edition id (for example `press`): the
# picker and every "Change edition" link disappear, the hr_flavor cookie and
# ?flavor= are ignored, and /f/<other>/<path> redirects to /<path>. Leave empty
# to let visitors choose. Read at build time, so rebuild after changing it.
# An id that is not a live edition fails the build. See docs/flavors/README.md.
NEXT_PUBLIC_FLAVOR=

# Optional. `true` shows owner-only art that can't be generated from the data
# (Minimal's handwritten signature). Leave unset for anyone else's data: those
# elements then render the profile name in the edition's display type.
NEXT_PUBLIC_OWNER_BRANDING=
# Optional. The Sanity Studio's title at /studio. Defaults to "Portfolio".
NEXT_PUBLIC_STUDIO_TITLE=

# --- /ask ---------------------------------------------------------------------
# Signs the anonymous `hr_anon` identity cookie and the `hr_owner` session
# cookie, and salts IP hashes. Use 32+ random bytes, e.g.
# `openssl rand -base64 32`. Changing it resets every visitor's identity and
# signs the owner out. Without it, /ask answers 503.
ASK_COOKIE_SECRET=
# Passphrase for owner mode: sign in at /owner to reply and moderate on the
# site. Server-only, never sent to the browser. Use a long random string, e.g.
# `openssl rand -base64 32`. Changing it signs out every device. Without it,
# owner sign-in answers 503. See docs/guides/ask.md.
ASK_OWNER_PASSPHRASE=
# Optional. Circuit-breaker ceiling: the form closes once this many messages
# are pending moderation. Positive integer, default 200. See docs/guides/ask.md.
ASK_PENDING_CAP=
# Optional. Number of reverse proxies in front of Next that append to
# X-Forwarded-For (usually 1). Leave empty when Next serves requests directly:
# the header is then client-controlled and ignored, and every visitor shares one
# daily submission cap. See docs/guides/ask.md.
ASK_TRUST_PROXY=
